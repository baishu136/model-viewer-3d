{
  "name": "model-viewer-3d",
  "version": "0.3.0",
  "description": "独立运行的 3D 模型与动画查看器，支持 FBX、GLB/glTF、OBJ、STL、PLY、BLEND、BLENDER、C4D、MA、MB、MAX、MD，以及 OBJ/STL/FBX/GLB/glTF/PLY/PMX 导出",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-clean.mjs",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win",
    "test:models": "python scripts/gen_test_models.py",
    "test": "node scripts/tests/e2e-test.mjs",
    "test:compatibility": "node scripts/tests/compatibility-test.mjs",
    "test:packaged": "node scripts/tests/final-verify.mjs",
    "test:installed": "node scripts/tests/test-installed.mjs",
    "test:portable": "node scripts/tests/test-portable.mjs",
    "test:single": "node scripts/tests/test-single-instance.mjs"
  },
  "devDependencies": {
    "@comfyorg/fbx-exporter-three": "^1.0.1",
    "@swc/core": "^1.15.47",
    "@types/three": "^0.171.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "three": "^0.171.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@swc/core@1.15.47": true
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "fzstd": "^0.1.1"
  }
}
